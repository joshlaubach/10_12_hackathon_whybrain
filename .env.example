# Backend only (apps/api). Copy to .env and fill in. Never commit .env.
HYDRADB_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
CORS_ORIGINS=http://localhost:3000,http://localhost:3100
# HydraDB collection (see docs/parallel-workflow.md): wb_dev_claude for development, wb_demo for the demo
HYDRADB_COLLECTION=wb_dev_claude
# apps/web/.env.local holds only: NEXT_PUBLIC_API_URL=http://localhost:8000
# Accepted decisions (ingested once by scripts/ingest.py) and drafts live in different collections.
# Defaults: HYDRA_ACCEPTED_COLLECTION=wb_demo, HYDRA_DRAFTS_COLLECTION=wb_dev_drafts (use wb_demo_drafts for the demo)
HYDRA_ACCEPTED_COLLECTION=wb_demo
HYDRA_DRAFTS_COLLECTION=wb_dev_drafts
