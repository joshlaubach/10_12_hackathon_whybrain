            "title": "Fixture",
            "type": "boolean"
          },
          "inspected_doc_ids": {
            "items": {
              "type": "string"
            },
            "title": "Inspected Doc Ids",
            "type": "array"
          },
          "provenance": {
            "$ref": "#/components/schemas/Provenance"
          },
          "recorded_contacts": {
            "description": "Authors recorded in the cited sources; not current owners",
            "items": {
              "type": "string"
            },
            "title": "Recorded Contacts",
            "type": "array"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "seq": {
            "description": "Strictly increasing within a request, starting at 0",
            "minimum": 0,
            "title": "Seq",
            "type": "integer"
          },
          "type": {
            "const": "review_completed",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "seq",
          "type",
          "findings",
          "inspected_doc_ids",
          "evidence_edges",
          "recorded_contacts",
          "draft_md",
          "as_of",
          "provenance"
        ],
        "title": "ReviewCompleted",
        "type": "object"
      },
      "Section": {
        "additionalProperties": false,
        "properties": {
          "heading": {
            "title": "Heading",
            "type": "string"
          },
          "locator": {
            "description": "Heading text, or 'Header' for the header block",
            "title": "Locator",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "locator",
          "heading",
          "text"
        ],
        "title": "Section",
        "type": "object"
      },
      "StreamError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "model_unavailable",
              "hydradb_unavailable",
              "retrieval_failed",
              "invalid_request",
              "draft_conflict",
              "not_found",
              "stream_interrupted",
              "timeout",
              "tool_limit_exceeded",
              "internal_error"
            ],
            "title": "Code",
            "type": "string"
          },
          "fixture": {
            "default": false,
            "description": "True for recorded fixtures; the UI shows 'Mock data'",
            "title": "Fixture",
            "type": "boolean"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "retryable": {
            "title": "Retryable",
            "type": "boolean"
          },
          "seq": {
            "description": "Strictly increasing within a request, starting at 0",
            "minimum": 0,
            "title": "Seq",
            "type": "integer"
          },
          "type": {
            "const": "error",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "seq",
          "type",
          "code",
          "message",
          "retryable"
        ],
        "title": "StreamError",
        "type": "object"
      },
      "StreamEvent": {
        "discriminator": {
          "mapping": {
            "answer_completed": "#/components/schemas/AnswerCompleted",
            "error": "#/components/schemas/StreamError",
            "request_started": "#/components/schemas/RequestStarted",
            "review_completed": "#/components/schemas/ReviewCompleted",
            "tool_completed": "#/components/schemas/ToolCompleted",
            "tool_started": "#/components/schemas/ToolStarted"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/components/schemas/RequestStarted"
          },
          {
            "$ref": "#/components/schemas/ToolStarted"
          },
          {
            "$ref": "#/components/schemas/ToolCompleted"
          },
          {
            "$ref": "#/components/schemas/AnswerCompleted"
          },
          {
            "$ref": "#/components/schemas/ReviewCompleted"
          },
          {
            "$ref": "#/components/schemas/StreamError"
          }
        ]
      },
      "ToolCompleted": {
        "additionalProperties": false,
        "properties": {
          "call_id": {
            "title": "Call Id",
            "type": "string"
          },
          "doc_ids": {
            "items": {
              "type": "string"
            },
            "title": "Doc Ids",
            "type": "array"
          },
          "fixture": {
            "default": false,
            "description": "True for recorded fixtures; the UI shows 'Mock data'",
            "title": "Fixture",
            "type": "boolean"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "seq": {
            "description": "Strictly increasing within a request, starting at 0",
            "minimum": 0,
            "title": "Seq",
            "type": "integer"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          },
          "tool": {
            "enum": [
              "search_brain",
              "get_decision",
              "follow_edges",
              "check_status",
              "find_conflicts"
            ],
            "title": "Tool",
            "type": "string"
          },
          "type": {
            "const": "tool_completed",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "seq",
          "type",
          "call_id",
          "tool",
          "ok",
          "summary",
          "doc_ids"
        ],
        "title": "ToolCompleted",
        "type": "object"
      },
      "ToolStarted": {
        "additionalProperties": false,
        "properties": {
          "args": {
            "additionalProperties": true,
            "title": "Args",
            "type": "object"
          },
          "call_id": {
            "title": "Call Id",
            "type": "string"
          },
          "fixture": {
            "default": false,
            "description": "True for recorded fixtures; the UI shows 'Mock data'",
            "title": "Fixture",
            "type": "boolean"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "seq": {
            "description": "Strictly increasing within a request, starting at 0",
            "minimum": 0,
            "title": "Seq",
            "type": "integer"
          },
          "tool": {
            "enum": [
              "search_brain",
              "get_decision",
              "follow_edges",
              "check_status",
              "find_conflicts"
            ],
            "title": "Tool",
            "type": "string"
          },
          "type": {
            "const": "tool_started",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "seq",
          "type",
          "call_id",
          "tool",
          "args"
        ],
        "title": "ToolStarted",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Why Brain API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/ask": {
      "post": {
        "operationId": "ask",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/StreamEvent"
                }
              }
            },
            "description": "SSE stream of StreamEvent; exactly one terminal event (answer_completed | error), then the server closes"
          }
        }
      }
    },
    "/api/decisions": {
      "get": {
        "operationId": "listDecisions",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionList"
                }
              }
            },
            "description": "Corpus documents"
          }
        }
      }
    },
    "/api/decisions/{doc_id}": {
      "get": {
        "operationId": "getDecision",
        "parameters": [
          {
            "in": "path",
            "name": "doc_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionDetail"
                }
              }
            },
            "description": "Document with source text"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not found"
          }
        }
      }
    },
    "/api/drafts": {
      "post": {
        "operationId": "saveDraft",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DraftCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DraftRecord"
                }
              }
            },
            "description": "Existing record (same draft_id and content_hash)"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DraftRecord"
                }
              }
            },
            "description": "Created"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "draft_conflict: same draft_id, different content"
          }
        }
      }
    },
    "/api/drafts/{draft_id}": {
      "get": {
        "operationId": "getDraft",
        "parameters": [
          {
            "in": "path",
            "name": "draft_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DraftRecord"
                }
              }
            },
            "description": "Record; retrieval verification reads from the store"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not found"
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Configuration only"
          }
        }
      }
    },
    "/api/proposals/review": {
      "post": {
        "operationId": "reviewProposal",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProposalReviewRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/StreamEvent"
                }
              }
            },
            "description": "SSE stream of StreamEvent; exactly one terminal event (review_completed | error), then the server closes"
          }
        }
      }
    }
  }
}
