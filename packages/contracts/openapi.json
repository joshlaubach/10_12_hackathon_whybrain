            "type": "array"
          },
          "body_text": {
            "title": "Body Text",
            "type": "string"
          },
          "discussions_to": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Discussions To"
          },
          "doc_id": {
            "description": "Stable id, e.g. pep-0386",
            "title": "Doc Id",
            "type": "string"
          },
          "missing_successors": {
            "description": "superseded_by ids that are not in the corpus snapshot",
            "items": {
              "type": "string"
            },
            "title": "Missing Successors",
            "type": "array"
          },
          "replaces": {
            "description": "From the source Replaces header",
            "items": {
              "$ref": "#/components/schemas/DocRef"
            },
            "title": "Replaces",
            "type": "array"
          },
          "resolution_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Resolution Url"
          },
          "sections": {
            "items": {
              "$ref": "#/components/schemas/Section"
            },
            "title": "Sections",
            "type": "array"
          },
          "snapshot_id": {
            "title": "Snapshot Id",
            "type": "string"
          },
          "source_status": {
            "description": "Verbatim source Status header: Final, Superseded, Withdrawn, ...",
            "title": "Source Status",
            "type": "string"
          },
          "source_url": {
            "title": "Source Url",
            "type": "string"
          },
          "superseded_by": {
            "description": "From the source Superseded-By header",
            "items": {
              "$ref": "#/components/schemas/DocRef"
            },
            "title": "Superseded By",
            "type": "array"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "doc_id",
          "source_url",
          "title",
          "source_status",
          "authors",
          "replaces",
          "superseded_by",
          "missing_successors",
          "snapshot_id",
          "body_text",
          "sections"
        ],
