{
  "components": {
    "schemas": {
      "AnswerCompleted": {
        "additionalProperties": false,
        "properties": {
          "abstain_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Abstain Reason"
          },
          "abstained": {
            "title": "Abstained",
            "type": "boolean"
          },
          "answer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Answer"
          },
          "as_of": {
            "description": "Corpus snapshot id; conclusions hold as of this snapshot",
            "title": "As Of",
            "type": "string"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "title": "Citations",
            "type": "array"
          },
          "evidence_edges": {
            "items": {
              "$ref": "#/components/schemas/EvidenceEdge"
            },
            "title": "Evidence Edges",
            "type": "array"
          },
          "fixture": {
            "default": false,
            "description": "True for recorded fixtures; the UI shows 'Mock data'",
            "title": "Fixture",
            "type": "boolean"
          },
          "inspected_doc_ids": {
            "items": {
              "type": "string"
            },
            "title": "Inspected Doc Ids",
            "type": "array"
          },
          "provenance": {
            "$ref": "#/components/schemas/Provenance"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "seq": {
            "description": "Strictly increasing within a request, starting at 0",
            "minimum": 0,
            "title": "Seq",
            "type": "integer"
          },
          "type": {
            "const": "answer_completed",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "seq",
          "type",
          "answer",
          "abstained",
          "citations",
          "inspected_doc_ids",
          "evidence_edges",
          "as_of",
          "provenance"
        ],
        "title": "AnswerCompleted",
        "type": "object"
      },
      "AskRequest": {
        "additionalProperties": false,
        "properties": {
          "mode_preference": {
            "default": "AUTO",
