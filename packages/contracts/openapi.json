          "explanation": {
            "title": "Explanation",
            "type": "string"
          },
          "finding_id": {
            "title": "Finding Id",
            "type": "string"
          },
          "locator": {
            "title": "Locator",
            "type": "string"
          },
          "quote": {
            "title": "Quote",
