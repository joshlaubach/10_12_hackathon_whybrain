      "DraftCreateRequest": {
        "additionalProperties": false,
        "properties": {
          "body_md": {
            "minLength": 1,
            "title": "Body Md",
            "type": "string"
          },
          "draft_id": {
            "description": "Client-generated UUID; also the idempotency key",
            "minLength": 8,
            "title": "Draft Id",
            "type": "string"
          },
          "proposes_to_replace": {
            "description": "doc_ids; a proposal, never an accepted replacement",
            "items": {
              "type": "string"
            },
            "title": "Proposes To Replace",
            "type": "array"
          },
          "title": {
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "draft_id",
          "title",
          "body_md",
          "proposes_to_replace"
        ],
        "title": "DraftCreateRequest",
        "type": "object"
      },
      "DraftRecord": {
        "additionalProperties": false,
        "description": "A saved proposal. It never changes accepted documents or authoritative edges.\n\nProvider indexing completion and retrieval verification are tracked separately.\n`status` is 'indexed' only when the provider finished indexing AND a retrieval of\nthis draft_id read from the real store (HydraDB, or the explicit local store in\nLOCAL mode), not from the backend's cached save response.",
        "properties": {
          "body_md": {
            "title": "Body Md",
            "type": "string"
          },
          "content_hash": {
            "title": "Content Hash",
            "type": "string"
          },
          "draft_id": {
            "title": "Draft Id",
            "type": "string"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Error"
          },
          "fixture": {
            "default": false,
            "title": "Fixture",
            "type": "boolean"
          },
          "label": {
            "const": "PROPOSAL",
            "default": "PROPOSAL",
            "title": "Label",
            "type": "string"
          },
          "proposes_to_replace": {
            "items": {
              "type": "string"
            },
            "title": "Proposes To Replace",
            "type": "array"
          },
          "provider_indexing": {
            "enum": [
              "pending",
              "completed",
              "failed"
            ],
            "title": "Provider Indexing",
            "type": "string"
          },
          "retrieval_verification": {
            "enum": [
              "pending",
              "verified",
              "failed"
            ],
            "title": "Retrieval Verification",
            "type": "string"
          },
          "status": {
            "enum": [
              "pending",
              "indexed",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "verified_via": {
            "anyOf": [
              {
                "enum": [
                  "hydradb",
                  "local_store"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Verified Via"
          }
        },
        "required": [
          "draft_id",
          "content_hash",
          "title",
          "body_md",
          "proposes_to_replace",
          "status",
          "provider_indexing",
          "retrieval_verification"
        ],
        "title": "DraftRecord",
        "type": "object"
      },
      "ErrorBody": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "model_unavailable",
              "hydradb_unavailable",
              "retrieval_failed",
              "invalid_request",
              "draft_conflict",
              "not_found",
              "stream_interrupted",
              "timeout",
              "tool_limit_exceeded",
              "internal_error"
