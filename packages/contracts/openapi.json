            "title": "Relation",
            "type": "string"
          },
          "source_url": {
            "title": "Source Url",
            "type": "string"
          },
          "uncertainty": {
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "title": "Uncertainty",
            "type": "string"
          }
        },
        "required": [
