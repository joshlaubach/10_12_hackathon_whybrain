          "configured",
          "snapshot_id",
          "corpus"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "ProposalFinding": {
        "additionalProperties": false,
        "properties": {
          "claim": {
            "description": "The part of the proposal this finding concerns",
